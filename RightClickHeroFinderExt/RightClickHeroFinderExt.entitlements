<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox — intentionally minimal; all file ops delegated to helper -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- App Group (read feature toggles + cut clipboard state) -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.yourco.rightclickhero</string>
    </array>

    <!-- Needed to create security-scoped bookmarks for selected items -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
</dict>
</plist>
